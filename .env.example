# Copy to .env and fill in. Never commit the real .env.
# One key covers the Meta Model API. Proven Meta legs go live when keys
# are present; with no keys every leg serves the demo cache.
META_API_KEY=
# Optional overrides (defaults shown):
# META_API_BASE=https://api.meta.ai/v1
# SPARK_MODEL=muse-spark-1.3
# SAM_MODEL=sam-3.1
# Baseten goes live when its key is present (Spark Open second look).
BASETEN_API_KEY=
# Proven model defaults (override only to pin another id):
# MUSE_WONDER_MODEL=muse-wonder-1.0
# MUSE_WONDER_PATH=/chat/completions
# MUSE_IMAGE_MODEL=muse-image-1.0
# MUSE_IMAGE_PATH=/responses
# Voice stays off until a model id is confirmed and one verification
# call succeeds (event docs list 'Muse Voice Transcribe'; other teams
# use muse-voice-transcribe-1.0). Set both to confirm, then flip
# VOICE_LIVE in voice.py after a verified call.
# MUSE_VOICE_MODEL=
# MUSE_VOICE_PATH=
# VIN plate read stays off: no plate image tested, privacy line holds.
# Force demo on every leg without touching keys (the Settings switch
# 'Force offline demo' is the per-request twin; either one wins):
# SHOP_DEMO=1
# GLIMMER_ENDPOINT=
