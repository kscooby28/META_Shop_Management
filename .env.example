# Copy to .env and fill in. Never commit the real .env.
# One key covers the Meta Model API.
META_API_KEY=
# Optional overrides (defaults shown):
# META_API_BASE=https://api.meta.ai/v1
# SPARK_MODEL=muse-spark-1.3
# SAM_MODEL=sam-3-1
# Empty means demo cache. Baseten goes live when its key is present;
# Meta legs additionally wait on the key rotation, never on keys alone.
BASETEN_API_KEY=
